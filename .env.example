# Public directory reads. Either name works. Prefer the server-only names below
# so the anon key is not required in the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required to approve a submission and publish the listing.
SUPABASE_SERVICE_ROLE_KEY=

# Sent as the x-admin-key header from the review page. Not stored in the page.
ADMIN_API_KEY=

# Server-only. Writes the action plan from listings the search already returned.
# If it is missing, search still shows the standard checklist.
GROK_API_KEY=

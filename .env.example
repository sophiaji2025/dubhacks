# Environment variables used by NeighborAid

# Public (client-side) Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase - keep this secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin header check (simple approach for admin endpoints)
ADMIN_API_KEY=replace-with-a-secret
